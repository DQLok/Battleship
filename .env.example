# ── Development (`npm run dev`) ──────────────────────────────────────────
# File ưu tiên: `.env.development.local` (gitignore) — Docker local.
#   VITE_SUPABASE_URL=http://127.0.0.1:54331
#   VITE_SUPABASE_ANON_KEY=<demo key từ `supabase status`>
#
# ── Production (`npm run build` / `npm run deploy`) ───────────────────────
# File: `.env.production` (có thể commit URL; anon key là public client key)
#   VITE_SUPABASE_URL=https://ngitfkvcrkrhwmxyefhu.supabase.co
#   VITE_SUPABASE_ANON_KEY=<Dashboard → Settings → API → anon public>
#
# Không dùng `.env.local` cho URL local — Vite load file đó mọi mode và
# làm deploy vẫn trỏ 127.0.0.1.

VITE_SUPABASE_URL=http://127.0.0.1:54331
VITE_SUPABASE_ANON_KEY=
