# Local Supabase (default for development)
# Run: npm run db:start && npm run db:status
# Battleship uses offset ports (54331+) because daily-food uses 54321+ on this machine.
VITE_SUPABASE_URL=http://127.0.0.1:54331
VITE_SUPABASE_ANON_KEY=

